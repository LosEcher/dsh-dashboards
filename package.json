{
  "name": "dsh-dashboards",
  "version": "0.1.0",
  "description": "DSH 看板：conversation.view「看板」tab，widget 网格展示 los 用量/节点矩阵 + macOS 原生探针 + 服务探活 +（可选）Glances/Uptime Kuma 后端；host 半包挂 /dashboards 同源聚合 API。",
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "files": ["index.mjs", "cordis.patch.yml", "lib/client.js", "README.md"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  }
}
